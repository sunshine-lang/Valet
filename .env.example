# 界面名称、接口标题，以及还没保存过的默认系统提示词。换项目时改这一行。
AGENT_NAME=Valet

# dashscope：阿里云百炼真实模型；mock：本地模拟模型（不需要 Key、不计费，按关键词触发探针工具）
LLM_PROVIDER=dashscope

# 阿里云百炼（通义千问）API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 其他供应商的密钥也可以写在这里，设置页留空时会用到。只填你要用的那一个。
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# 中国内地地域的 OpenAI 兼容地址；国际地域改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜索，二选一。博查：https://open.bochaai.com  Tavily：https://tavily.com
BOCHA_API_KEY=
TAVILY_API_KEY=

DATABASE_URL=postgresql+asyncpg://valet:valet@localhost:5433/valet

# 前端开发服务器地址（CORS 白名单）
WEB_ORIGIN=http://localhost:5173
