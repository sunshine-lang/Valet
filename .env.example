# 界面名称、接口标题，以及还没保存过的默认系统提示词。换项目时改这一行。
AGENT_NAME=Valet

# 阿里云百炼（通义千问）API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash-0731
# 其他供应商的密钥也可以写在这里，设置页留空时会用到。只填你要用的那一个。
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# 中国内地地域的 OpenAI 兼容地址；国际地域改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜索，二选一。博查：https://open.bochaai.com  Tavily：https://tavily.com
BOCHA_API_KEY=
TAVILY_API_KEY=

# 默认使用仓库下的 .valet/valet.db，无需启动数据库服务。
# 如需 PostgreSQL，启动 docker compose 后配置：
# DATABASE_URL=postgresql+asyncpg://valet:valet@localhost:5433/valet

# 前端开发服务器地址（CORS 白名单）
WEB_ORIGIN=http://localhost:5173
